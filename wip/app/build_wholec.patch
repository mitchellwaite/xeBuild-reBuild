diff --git a/build.sh b/build.sh
index 0078f6f..e04c4e5 100644
--- a/build.sh
+++ b/build.sh
@@ -85,9 +85,11 @@ for f in $(grep -v '^#' src/objects.txt | tr -d '\r'); do
       # netSendFile's !name hint (55-65), netRecvVerbose's verbose hint (65)
       app/net) orig="$f.c"
              cflags="-O3 --param builtin-expect-probability=65" ;;
-      # loadFileCrc's verbose hint (92-99); 98 for wip/'s checkBl draft
+      # loadFileCrc's verbose hint (92-99), checkBl's needs 98;
+      # -fno-toplevel-reorder emits the functions, string arrays and .data
+      # in definition order
       app/build) orig="$f.c"
-             cflags="-O3 --param builtin-expect-probability=98" ;;
+             cflags="-O3 -fno-toplevel-reorder --param builtin-expect-probability=98" ;;
       # original path unknown (no assert in the app); timeutil needs -O3
       app/*) orig="$f.c"
              cflags="-O3" ;;
