+/* the 0x60-byte bootloader (type 24) from the base dir, else the default */
+static int loadBl60(struct fileent *e)
+{
+	if (loadBaseFile(e->name, e) || e->size != 0x60) {
+		e->data = malloc(0x60);
+		if (!e->data)
+			return 1;
+		{
+		u8 *p = e->data;
+
+		__asm__("" : "+r"(p));
+		e->size = 0x60;
+		memcpy(__builtin_assume_aligned(p, 4), defBl60, 0x60);
+		}
+	}
+	return 0;
+}
